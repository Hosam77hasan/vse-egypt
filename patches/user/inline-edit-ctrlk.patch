+/*---------------------------------------------------------------------------------------------
+ *  VS Code Egypt — proprietary addition. Not part of upstream Microsoft/VSCodium source.
+ *
+ *  Plain DOM content widgets (no webview) — this is a small text input and a couple of
+ *  buttons, not rich content, so a full webview would be unnecessary IPC overhead. Same
+ *  approach VS Code's own Parameter Hints / Rename widgets use.
+ *--------------------------------------------------------------------------------------------*/
+
+import { ICodeEditor, IContentWidget, IContentWidgetPosition, ContentWidgetPositionPreference } from '../../../../editor/browser/editorBrowser.js';
+import { IPosition } from '../../../../editor/common/core/position.js';
+
+export class InlineEditPromptWidget implements IContentWidget {
+
+	private static readonly ID = 'vscodeEgypt.inlineEditPromptWidget';
+
+	readonly allowEditorOverflow = true;
+
+	private readonly domNode: HTMLDivElement;
+	private readonly input: HTMLTextAreaElement;
+	private readonly modelSelect: HTMLSelectElement;
+	private readonly statusLabel: HTMLSpanElement;
+	private anchorPosition: IPosition | null = null;
+
+	constructor(
+		private readonly editor: ICodeEditor,
+		private readonly onSubmit: (text: string, model: string) => void,
+		private readonly onCancel: () => void,
+	) {
+		this.domNode = document.createElement('div');
+		this.domNode.className = 'vscode-egypt-inline-edit-prompt';
+		this.domNode.style.cssText = `
+			background: #000; border: 1px solid #C6FF00; border-radius: 8px;
+			padding: 8px; display: flex; flex-direction: column; gap: 6px;
+			width: 380px; box-shadow: 0 8px 24px rgba(198,255,0,0.15);
+			font-family: var(--vscode-font-family, sans-serif);
+		`;
+
+		const row = document.createElement('div');
+		row.style.cssText = 'display:flex; align-items:center; gap:6px;';
+
+		this.input = document.createElement('textarea');
+		this.input.rows = 1;
+		this.input.placeholder = 'Describe the edit... (Enter to submit, Esc to cancel)';
+		this.input.style.cssText = `
+			flex: 1; resize: none; background: #0a0a0a; color: #fff;
+			border: 1px solid #333; border-radius: 5px; padding: 6px 8px;
+			font-family: inherit; font-size: 13px; outline: none;
+		`;
+		row.appendChild(this.input);
+		this.domNode.appendChild(row);
+
+		const modelRow = document.createElement('div');
+		modelRow.style.cssText = 'display:flex; justify-content:flex-end;';
+		this.modelSelect = document.createElement('select');
+		this.modelSelect.style.cssText = `
+			background: #0a0a0a; color: #C6FF00; border: 1px solid #333;
+			border-radius: 5px; padding: 3px 6px; font-size: 11px; font-family: inherit;
+		`;
+		// Hardcoded branded labels (not fetched from /v1/models) — this widget is
+		// small and transient, and the three aliases are stable product names, so
+		// the extra round-trip isn't worth it here the way it is for the sidebar
+		// chat panel's persistent dropdown.
+		for (const [alias, label] of [['driver', 'السائق (Driver)'], ['leader', 'القائد (Leader)'], ['innovator', 'المبتكر (Innovator)']]) {
+			const opt = document.createElement('option');
+			opt.value = alias;
+			opt.textContent = label;
+			this.modelSelect.appendChild(opt);
+		}
+		modelRow.appendChild(this.modelSelect);
+		this.domNode.appendChild(modelRow);
+
+		this.statusLabel = document.createElement('span');
+		this.statusLabel.style.cssText = 'font-size: 11px; color: #888; display: none;';
+		this.domNode.appendChild(this.statusLabel);
+
+		this.input.addEventListener('keydown', (e) => {
+			if (e.key === 'Enter' && !e.shiftKey) {
+				e.preventDefault();
+				const text = this.input.value.trim();
+				if (text) {
+					this.onSubmit(text, this.modelSelect.value);
+				}
+			} else if (e.key === 'Escape') {
+				e.preventDefault();
+				this.onCancel();
+			}
+			// Stop propagation so the editor doesn't also react to these keys
+			// (e.g. Escape closing find-widget, or the editor swallowing Enter).
+			e.stopPropagation();
+		});
+	}
+
+	show(position: IPosition): void {
+		this.anchorPosition = position;
+		this.editor.addContentWidget(this);
+		// Focus after the editor has actually placed the widget in the DOM.
+		requestAnimationFrame(() => this.input.focus());
+	}
+
+	setBusy(busy: boolean): void {
+		this.input.disabled = busy;
+		this.statusLabel.style.display = busy ? 'block' : 'none';
+		this.statusLabel.textContent = busy ? 'Generating…' : '';
+	}
+
+	setError(message: string): void {
+		this.statusLabel.style.display = 'block';
+		this.statusLabel.style.color = '#ff6b6b';
+		this.statusLabel.textContent = message;
+		this.input.disabled = false;
+	}
+
+	dispose(): void {
+		this.editor.removeContentWidget(this);
+	}
+
+	getId(): string {
+		return InlineEditPromptWidget.ID;
+	}
+
+	getDomNode(): HTMLElement {
+		return this.domNode;
+	}
+
+	getPosition(): IContentWidgetPosition | null {
+		if (!this.anchorPosition) {
+			return null;
+		}
+		return {
+			position: this.anchorPosition,
+			preference: [ContentWidgetPositionPreference.ABOVE, ContentWidgetPositionPreference.BELOW],
+		};
+	}
+}
