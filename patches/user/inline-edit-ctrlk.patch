+++ b/src/vs/workbench/contrib/vscodeEgyptInlineEdit/browser/inlineEditDiffZoneWidget.ts
@@ -0,0 +1,119 @@
+/*---------------------------------------------------------------------------------------------
+ *  VS Code Egypt — proprietary addition. Not part of upstream Microsoft/VSCodium source.
+ *
+ *  Genuine non-destructive diff preview for Ctrl+K, superseding the earlier
+ *  apply-then-optionally-revert approach. This embeds a REAL DiffEditorWidget (the same
+ *  class VS Code's own diff view uses) inside a ZoneWidget anchored below the selection —
+ *  both are real, existing VS Code classes, not hand-built ghost-text CSS. Two ephemeral
+ *  ITextModels (never attached to any file) hold the "before" and "after" text; the actual
+ *  document is not touched until the caller applies the edit on Accept/Tab.
+ *
+ *  Why not registerInlineCompletionsProvider for this (used instead for Tab-completion,
+ *  see inlineCompletionProvider.ts)? Its `range` must "begin and end on the same line" and
+ *  the existing text must be a *prefix* of the inserted text — real, documented constraints
+ *  in InlineCompletion's own interface. Ctrl+K needs to replace an arbitrary multi-line
+ *  selection with unrelated new content, which that API isn't built for.
+ *--------------------------------------------------------------------------------------------*/
+
+import { ZoneWidget } from '../../../../editor/contrib/zoneWidget/browser/zoneWidget.js';
+import { ICodeEditor } from '../../../../editor/browser/editorBrowser.js';
+import { EmbeddedDiffEditorWidget } from '../../../../editor/browser/widget/diffEditor/embeddedDiffEditorWidget.js';
+import { IModelService } from '../../../../editor/common/services/model.js';
+import { ILanguageService } from '../../../../editor/common/languages/language.js';
+import { IInstantiationService } from '../../../../platform/instantiation/common/instantiation.js';
+import { ITextModel } from '../../../../editor/common/model.js';
+import { Range } from '../../../../editor/common/core/range.js';
+
+export class InlineEditDiffZoneWidget extends ZoneWidget {
+
+	private diffEditor: EmbeddedDiffEditorWidget | undefined;
+	private originalModel: ITextModel | undefined;
+	private modifiedModel: ITextModel | undefined;
+	private actionsContainer: HTMLDivElement | undefined;
+	private onAcceptCallback: (() => void) | undefined;
+	private onRejectCallback: (() => void) | undefined;
+
+	constructor(
+		editor: ICodeEditor,
+		private readonly languageId: string,
+		@IInstantiationService private readonly instantiationService: IInstantiationService,
+		@IModelService private readonly modelService: IModelService,
+		@ILanguageService private readonly languageService: ILanguageService,
+	) {
+		super(editor, { showFrame: true, showArrow: true, className: 'vscode-egypt-diff-zone' });
+	}
+
+	protected override _fillContainer(container: HTMLElement): void {
+		const diffContainer = document.createElement('div');
+		diffContainer.style.height = '240px';
+		container.appendChild(diffContainer);
+
+		this.actionsContainer = document.createElement('div');
+		this.actionsContainer.style.cssText = 'display:flex; gap:8px; padding:6px 10px; background:#000; border-top:1px solid #C6FF00;';
+		container.appendChild(this.actionsContainer);
+
+		this.diffEditor = this.instantiationService.createInstance(
+			EmbeddedDiffEditorWidget,
+			diffContainer,
+			{ readOnly: true, renderSideBySide: false, automaticLayout: true, glyphMargin: false, folding: false, minimap: { enabled: false } },
+			{},
+			this.editor,
+		);
+
+		// Tab-to-accept / Escape-to-reject, per spec. Attached to the zone's own
+		// container (capture phase) rather than a context-key-gated command, since
+		// this widget's lifetime already scopes exactly when these keys should apply —
+		// no separate "is diff zone visible" context key needed.
+		container.tabIndex = -1;
+		container.addEventListener('keydown', (e) => {
+			if (e.key === 'Tab') {
+				e.preventDefault();
+				this.onAcceptCallback?.();
+			} else if (e.key === 'Escape') {
+				e.preventDefault();
+				this.onRejectCallback?.();
+			}
+		}, true);
+	}
+
+	/** Renders the preview and returns handlers to wire up Accept/Reject buttons + Tab/Esc keys. */
+	showPreview(range: Range, originalText: string, newText: string, onAccept: () => void, onReject: () => void): void {
+		this.onAcceptCallback = onAccept;
+		this.onRejectCallback = onReject;
+
+		const languageSelection = this.languageService.createById(this.languageId);
+		this.originalModel = this.modelService.createModel(originalText, languageSelection, undefined, true);
+		this.modifiedModel = this.modelService.createModel(newText, languageSelection, undefined, true);
+
+		// heightInLines is a rough estimate — the embedded diff editor's own automaticLayout
+		// handles the container fill; this just reserves enough vertical space in the zone.
+		const lineEstimate = Math.max(originalText.split('\n').length, newText.split('\n').length);
+		this.show(new Range(range.endLineNumber, 1, range.endLineNumber, 1), Math.min(lineEstimate + 4, 20));
+
+		this.diffEditor?.setModel({ original: this.originalModel, modified: this.modifiedModel });
+		this.domNode.tabIndex = -1;
+		this.domNode.focus();
+
+		if (this.actionsContainer) {
+			this.actionsContainer.innerHTML = '';
+			const acceptBtn = document.createElement('button');
+			acceptBtn.textContent = '✓ Accept (Tab)';
+			acceptBtn.style.cssText = 'background:#C6FF00; color:#000; border:none; border-radius:4px; padding:5px 12px; cursor:pointer; font-weight:700; font-size:12px;';
+			acceptBtn.onclick = () => this.onAcceptCallback?.();
+
+			const rejectBtn = document.createElement('button');
+			rejectBtn.textContent = '✕ Reject (Esc)';
+			rejectBtn.style.cssText = 'background:#1a1a1a; color:#fff; border:1px solid #333; border-radius:4px; padding:5px 12px; cursor:pointer; font-size:12px;';
+			rejectBtn.onclick = () => this.onRejectCallback?.();
+
+			this.actionsContainer.appendChild(acceptBtn);
+			this.actionsContainer.appendChild(rejectBtn);
+		}
+	}
+
+	override dispose(): void {
+		this.originalModel?.dispose();
+		this.modifiedModel?.dispose();
+		super.dispose();
+	}
+}
