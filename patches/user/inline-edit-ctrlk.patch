+/*---------------------------------------------------------------------------------------------
+ *  VS Code Egypt — proprietary addition. Not part of upstream Microsoft/VSCodium source.
+ *
+ *  Ctrl+K inline editing. The generated replacement is shown as a genuine non-destructive
+ *  diff preview (see inlineEditDiffZoneWidget.ts — a real embedded DiffEditorWidget in a
+ *  ZoneWidget) before anything touches the buffer. executeEdits() is called for the first
+ *  time only in accept(), on explicit Accept-button-click or Tab. Reject just closes the
+ *  preview; since the buffer was never modified, there's nothing to revert.
+ *
+ *  Not implemented in this pass: token-by-token streaming into the preview while
+ *  generating. The prompt widget shows a "Generating…" state and renders the diff preview
+ *  once the stream completes, rather than growing the modified-side text live — avoids the
+ *  complexity of re-diffing against a moving target on every token.
+ *--------------------------------------------------------------------------------------------*/
+
+import { ICodeEditor } from '../../../../editor/browser/editorBrowser.js';
+import { IEditorContribution } from '../../../../editor/common/editorCommon.js';
+import { EditorContributionInstantiation, registerEditorContribution, EditorAction, registerEditorAction, ServicesAccessor } from '../../../../editor/browser/editorExtensions.js';
+import { EditorContextKeys } from '../../../../editor/common/editorContextKeys.js';
+import { KeybindingWeight } from '../../../../platform/keybinding/common/keybindingsRegistry.js';
+import { KeyMod, KeyCode } from '../../../../base/common/keyCodes.js';
+import { Selection } from '../../../../editor/common/core/selection.js';
+import { Range } from '../../../../editor/common/core/range.js';
+import { IStorageService, StorageScope } from '../../../../platform/storage/common/storage.js';
+import { IProductService } from '../../../../platform/product/common/productService.js';
+import { IInstantiationService } from '../../../../platform/instantiation/common/instantiation.js';
+import { ACCESS_TOKEN_STORAGE_KEY } from '../../vscodeEgyptLicense/browser/licenseGate.contribution.js';
+import { InlineEditPromptWidget } from './inlineEditWidgets.js';
+import { InlineEditDiffZoneWidget } from './inlineEditDiffZoneWidget.js';
+
+const DEFAULT_API_BASE = 'https://api.vscode-egypt.example/v1';
+
+export class VSCodeEgyptInlineEditController implements IEditorContribution {
+
+	static readonly ID = 'vscodeEgypt.inlineEditController';
+
+	private promptWidget: InlineEditPromptWidget | undefined;
+	private diffZone: InlineEditDiffZoneWidget | undefined;
+
+	constructor(
+		private readonly editor: ICodeEditor,
+		@IStorageService private readonly storageService: IStorageService,
+		@IProductService private readonly productService: IProductService,
+		@IInstantiationService private readonly instantiationService: IInstantiationService,
+	) { }
+
+	start(): void {
+		if (this.promptWidget) {
+			return; // already open — Ctrl+K again while the prompt is up is a no-op, not a reset
+		}
+		const selection = this.editor.getSelection();
+		if (!selection || selection.isEmpty()) {
+			return; // nothing selected — nothing to instruct an edit on
+		}
+
+		this.promptWidget = new InlineEditPromptWidget(
+			this.editor,
+			(instruction, model) => this.submit(selection, instruction, model),
+			() => this.cancelPrompt(),
+		);
+		this.promptWidget.show({ lineNumber: selection.startLineNumber, column: selection.startColumn });
+	}
+
+	private cancelPrompt(): void {
+		this.promptWidget?.dispose();
+		this.promptWidget = undefined;
+	}
+
+	private async submit(originalSelection: Selection, instruction: string, model: string): Promise<void> {
+		const textModel = this.editor.getModel();
+		if (!textModel) {
+			this.cancelPrompt();
+			return;
+		}
+
+		const originalRange = originalSelection as Range;
+		const originalText = textModel.getValueInRange(originalRange);
+		const language = textModel.getLanguageId();
+
+		this.promptWidget?.setBusy(true);
+
+		const accessToken = this.storageService.get(ACCESS_TOKEN_STORAGE_KEY, StorageScope.APPLICATION);
+		if (!accessToken) {
+			this.promptWidget?.setError('Not signed in.');
+			return;
+		}
+
+		try {
+			const newText = await this.generateReplacement(accessToken, instruction, originalText, language, model);
+			this.cancelPrompt();
+			this.applyEdit(originalRange, originalText, newText);
+		} catch (err) {
+			this.promptWidget?.setError(err instanceof Error ? err.message : 'Generation failed.');
+		}
+	}
+
+	/**
+	 * Calls the "driver" model (fast code-editing model) with an instruction that
+	 * constrains it to return ONLY the replacement code — no markdown fences, no
+	 * explanation — since this text goes straight into the buffer. Collects the full
+	 * streamed response before returning; see the file-level note on why this isn't
+	 * applied token-by-token.
+	 */
+	private async generateReplacement(accessToken: string, instruction: string, originalText: string, language: string, model: string): Promise<string> {
+		const apiBase = (this.productService as unknown as { vscodeEgyptLicenseApiBaseUrl?: string }).vscodeEgyptLicenseApiBaseUrl ?? DEFAULT_API_BASE;
+
+		const systemPrompt = [
+			'You are an inline code-editing assistant integrated directly into a code editor.',
+			`The user selected the following ${language} code and gave an instruction for how to change it.`,
+			'Respond with ONLY the replacement code for the selection — no markdown code fences, no explanation, no surrounding commentary.',
+			'Preserve the original indentation style unless the instruction asks otherwise.',
+		].join(' ');
+
+		const response = await fetch(`${apiBase}/chat`, {
+			method: 'POST',
+			headers: {
+				'Content-Type': 'application/json',
+				'Authorization': `Bearer ${accessToken}`,
+			},
+			body: JSON.stringify({
+				model,
+				messages: [
+					{ role: 'system', content: systemPrompt },
+					{ role: 'user', content: `Instruction: ${instruction}\n\nSelected code:\n${originalText}` },
+				],
+			}),
+		});
+
+		if (!response.ok || !response.body) {
+			throw new Error(`AI service error (${response.status}).`);
+		}
+
+		const reader = response.body.getReader();
+		const decoder = new TextDecoder();
+		let result = '';
+
+		while (true) {
+			const { done, value } = await reader.read();
+			if (done) {
+				break;
+			}
+			const chunk = decoder.decode(value, { stream: true });
+			for (const line of chunk.split('\n')) {
+				if (!line.startsWith('data: ')) {
+					continue;
+				}
+				const payload = line.slice(6).trim();
+				if (payload === '[DONE]') {
+					continue;
+				}
+				try {
+					const parsed = JSON.parse(payload) as { choices?: { delta?: { content?: string } }[] };
+					const delta = parsed.choices?.[0]?.delta?.content;
+					if (delta) {
+						result += delta;
+					}
+				} catch {
+					// partial JSON fragment split across a chunk boundary — resolved by
+					// the next chunk's concatenation, nothing to do here.
+				}
+			}
+		}
+
+		return result;
+	}
+
+	private applyEdit(originalRange: Range, originalText: string, newText: string): void {
+		const model = this.editor.getModel();
+		if (!model) {
+			return;
+		}
+
+		this.diffZone?.dispose();
+		this.diffZone = this.instantiationService.createInstance(InlineEditDiffZoneWidget, this.editor, model.getLanguageId());
+		this.diffZone.showPreview(
+			originalRange,
+			originalText,
+			newText,
+			() => this.accept(originalRange, newText),
+			() => this.reject(),
+		);
+	}
+
+	private accept(range: Range, newText: string): void {
+		this.editor.executeEdits('vscodeEgyptInlineEdit', [{ range, text: newText }]);
+		this.diffZone?.dispose();
+		this.diffZone = undefined;
+	}
+
+	private reject(): void {
+		// The buffer was never touched — this preview is a ZoneWidget over two
+		// ephemeral, unattached text models, so "reject" is just closing it. No
+		// second edit is needed to "undo" anything, unlike the old apply-then-revert
+		// design this replaced.
+		this.diffZone?.dispose();
+		this.diffZone = undefined;
+	}
+
+	dispose(): void {
+		this.promptWidget?.dispose();
+		this.diffZone?.dispose();
+	}
+}
+
+registerEditorContribution(VSCodeEgyptInlineEditController.ID, VSCodeEgyptInlineEditController, EditorContributionInstantiation.Lazy);
+
+class TriggerInlineEditAction extends EditorAction {
+	constructor() {
+		super({
+			id: 'vscodeEgypt.triggerInlineEdit',
+			label: 'VS Code Egypt: Edit Selection with AI',
+			alias: 'VS Code Egypt: Edit Selection with AI',
+			precondition: EditorContextKeys.editorTextFocus,
+			kbOpts: {
+				kbExpr: EditorContextKeys.editorTextFocus,
+				primary: KeyMod.CtrlCmd | KeyCode.KeyK,
+				weight: KeybindingWeight.EditorContrib,
+			},
+		});
+	}
+
+	run(_accessor: ServicesAccessor, editor: ICodeEditor): void {
+		const controller = editor.getContribution<VSCodeEgyptInlineEditController>(VSCodeEgyptInlineEditController.ID);
+		controller?.start();
+	}
+}
+
+registerEditorAction(TriggerInlineEditAction);
