+++ b/src/vs/workbench/contrib/vscodeEgyptLicense/browser/licenseGate.contribution.ts
@@ -0,0 +1,192 @@
+/*---------------------------------------------------------------------------------------------
+ *  VS Code Egypt — proprietary addition. Not part of upstream Microsoft/VSCodium source.
+ *
+ *  Registers a WorkbenchPhase.BlockStartup contribution that runs TWO gates in sequence
+ *  before the editor becomes interactive:
+ *
+ *    1. AUTH gate — if there's no stored access token, show an embedded login/signup
+ *       webview modal (with email OTP verification) and block until the user completes it.
+ *    2. PLAN gate — once authenticated, if the account's plan is 'free', show a
+ *       non-blocking upsell dialog pointing at the web billing dashboard. This does NOT
+ *       hard-block startup (free users can still use the editor without AI features) —
+ *       only the auth step blocks startup; AI commands separately check plan status
+ *       before running (see vscodeEgyptChatService.ts).
+ *
+ *  Design note: an earlier iteration of this file used a separate, standalone
+ *  "license token" issued only by the payment portal. That's collapsed here — the
+ *  account's `plan` field (returned by /v1/auth/login, /verify-email, /me) is now the
+ *  single source of truth for entitlement. The payment-portal-issued JWT from
+ *  vse-backend/routes/license.js still exists and still works for gift-code / offline
+ *  activation flows, but day-to-day gating now rides on the auth session, not a
+ *  second parallel token system.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Registry } from '../../../../platform/registry/common/platform.js';
+import { IWorkbenchContributionsRegistry, Extensions as WorkbenchExtensions, IWorkbenchContribution, WorkbenchPhase, registerWorkbenchContribution2 } from '../../../common/contributions.js';
+import { IDialogService } from '../../../../platform/dialogs/common/dialogs.js';
+import { IStorageService, StorageScope, StorageTarget } from '../../../../platform/storage/common/storage.js';
+import { IOpenerService } from '../../../../platform/opener/common/opener.js';
+import { URI } from '../../../../base/common/uri.js';
+import { ILogService } from '../../../../platform/log/common/log.js';
+import { IProductService } from '../../../../platform/product/common/productService.js';
+import { IInstantiationService } from '../../../../platform/instantiation/common/instantiation.js';
+import { VSCodeEgyptAuthModal } from './authModal.js';
+
+export const ACCESS_TOKEN_STORAGE_KEY = 'vscodeEgypt.accessToken';
+export const REFRESH_TOKEN_STORAGE_KEY = 'vscodeEgypt.refreshToken';
+export const ACCOUNT_STORAGE_KEY = 'vscodeEgypt.account'; // JSON: { id, email, plan }
+const AUTH_CACHE_KEY = 'vscodeEgypt.authVerifiedUntil';
+
+// Set at build time via product.json -> vscodeEgyptLicenseApiBaseUrl (see prepare_vscode.sh injection).
+// Defaults here only for local dev; the real fork build MUST override this in product.json.
+const DEFAULT_API_BASE = 'https://api.vscode-egypt.example/v1';
+
+export interface IVSCodeEgyptAccount {
+	id: number;
+	email: string;
+	plan: 'free' | 'pro' | 'team';
+}
+
+export class VSCodeEgyptOnboardingGateContribution implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.vscodeEgyptOnboardingGate';
+
+	constructor(
+		@IDialogService private readonly dialogService: IDialogService,
+		@IStorageService private readonly storageService: IStorageService,
+		@IOpenerService private readonly openerService: IOpenerService,
+		@ILogService private readonly logService: ILogService,
+		@IProductService private readonly productService: IProductService,
+		@IInstantiationService private readonly instantiationService: IInstantiationService,
+	) { }
+
+	private get apiBase(): string {
+		return (this.productService as unknown as { vscodeEgyptLicenseApiBaseUrl?: string }).vscodeEgyptLicenseApiBaseUrl ?? DEFAULT_API_BASE;
+	}
+
+	// Returning a Promise here is what makes WorkbenchPhase.BlockStartup actually block.
+	async run(): Promise<void> {
+		const account = await this.ensureAuthenticated();
+		if (account.plan === 'free') {
+			// Non-blocking: shown, but startup already proceeds regardless of the answer.
+			this.showUpsellDialog();
+		}
+	}
+
+	/**
+	 * Blocks until we have a verified access token. Either it's already cached and
+	 * fresh, or we re-validate it against /v1/auth/me, or (if missing/invalid/expired)
+	 * we show the login/signup modal and wait for it to resolve.
+	 */
+	private async ensureAuthenticated(): Promise<IVSCodeEgyptAccount> {
+		const cachedUntil = this.storageService.getNumber(AUTH_CACHE_KEY, StorageScope.APPLICATION, 0);
+		const storedAccessToken = this.storageService.get(ACCESS_TOKEN_STORAGE_KEY, StorageScope.APPLICATION);
+		const storedAccountRaw = this.storageService.get(ACCOUNT_STORAGE_KEY, StorageScope.APPLICATION);
+
+		if (storedAccessToken && storedAccountRaw && Date.now() < cachedUntil) {
+			try {
+				return JSON.parse(storedAccountRaw) as IVSCodeEgyptAccount;
+			} catch {
+				// fall through to re-auth if the stored JSON is somehow corrupt
+			}
+		}
+
+		if (storedAccessToken) {
+			const account = await this.tryVerifyAccessToken(storedAccessToken);
+			if (account) {
+				this.persistSession(storedAccessToken, this.storageService.get(REFRESH_TOKEN_STORAGE_KEY, StorageScope.APPLICATION) ?? '', account);
+				return account;
+			}
+			// Access token expired — try silent refresh before bothering the user.
+			const refreshed = await this.tryRefresh();
+			if (refreshed) {
+				return refreshed;
+			}
+		}
+
+		// No valid session — show the modal and block until the user signs in or up.
+		return this.showAuthModal();
+	}
+
+	private async tryVerifyAccessToken(accessToken: string): Promise<IVSCodeEgyptAccount | undefined> {
+		try {
+			const response = await fetch(`${this.apiBase}/auth/me`, {
+				headers: { 'Authorization': `Bearer ${accessToken}` },
+			});
+			if (!response.ok) {
+				return undefined;
+			}
+			const data = await response.json() as { user: IVSCodeEgyptAccount };
+			return data.user;
+		} catch (err) {
+			this.logService.warn('[VS Code Egypt] auth/me check failed', err);
+			return undefined;
+		}
+	}
+
+	private async tryRefresh(): Promise<IVSCodeEgyptAccount | undefined> {
+		const refreshToken = this.storageService.get(REFRESH_TOKEN_STORAGE_KEY, StorageScope.APPLICATION);
+		if (!refreshToken) {
+			return undefined;
+		}
+		try {
+			const response = await fetch(`${this.apiBase}/auth/refresh`, {
+				method: 'POST',
+				headers: { 'Content-Type': 'application/json' },
+				body: JSON.stringify({ refreshToken }),
+			});
+			if (!response.ok) {
+				return undefined;
+			}
+			const data = await response.json() as { user: IVSCodeEgyptAccount; accessToken: string; refreshToken: string };
+			this.persistSession(data.accessToken, data.refreshToken, data.user);
+			return data.user;
+		} catch (err) {
+			this.logService.warn('[VS Code Egypt] silent refresh failed', err);
+			return undefined;
+		}
+	}
+
+	private async showAuthModal(): Promise<IVSCodeEgyptAccount> {
+		const modal = this.instantiationService.createInstance(VSCodeEgyptAuthModal, this.apiBase);
+		const result = await modal.open(); // blocks until signup+OTP or login succeeds
+		this.persistSession(result.accessToken, result.refreshToken, result.user);
+		return result.user;
+	}
+
+	private persistSession(accessToken: string, refreshToken: string, account: IVSCodeEgyptAccount): void {
+		this.storageService.store(ACCESS_TOKEN_STORAGE_KEY, accessToken, StorageScope.APPLICATION, StorageTarget.MACHINE);
+		this.storageService.store(REFRESH_TOKEN_STORAGE_KEY, refreshToken, StorageScope.APPLICATION, StorageTarget.MACHINE);
+		this.storageService.store(ACCOUNT_STORAGE_KEY, JSON.stringify(account), StorageScope.APPLICATION, StorageTarget.MACHINE);
+		// Access tokens are short-lived (15m server-side); re-verify at most every 10
+		// minutes rather than trusting the cache for the token's full nominal lifetime.
+		this.storageService.store(AUTH_CACHE_KEY, Date.now() + (10 * 60 * 1000), StorageScope.APPLICATION, StorageTarget.MACHINE);
+	}
+
+	private async showUpsellDialog(): Promise<void> {
+		await this.dialogService.prompt({
+			type: 'info',
+			message: 'You\'re on the Free plan',
+			detail: 'Upgrade to Pro or Team to unlock AI features (Ctrl+K inline edits and the AI chat panel).',
+			buttons: [
+				{
+					label: 'View Plans',
+					run: () => {
+						this.openerService.open(URI.parse('https://portal.vscode-egypt.example/dashboard/billing'));
+					}
+				},
+			],
+			cancelButton: {
+				label: 'Not now',
+				run: () => { /* no-op — AI commands re-check plan status themselves before running */ }
+			}
