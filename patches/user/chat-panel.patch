+/*---------------------------------------------------------------------------------------------
+ *  VS Code Egypt — proprietary addition. Not part of upstream Microsoft/VSCodium source.
+ *
+ *  Registers the sidebar container + single view for the AI chat panel, in the same
+ *  `order: 4` slot the (now-hidden) Extensions viewlet used to occupy.
+ *--------------------------------------------------------------------------------------------*/
+
+import { localize2 } from '../../../../nls.js';
+import { Registry } from '../../../../platform/registry/common/platform.js';
+import { SyncDescriptor } from '../../../../platform/instantiation/common/descriptors.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { registerIcon } from '../../../../platform/theme/common/iconRegistry.js';
+import { ViewPaneContainer } from '../../../browser/parts/views/viewPaneContainer.js';
+import { Extensions as ViewContainerExtensions, IViewContainersRegistry, IViewsRegistry, Extensions as ViewExtensions, ViewContainerLocation } from '../../../common/views.js';
+import { VSCodeEgyptChatViewPane } from './chatViewPane.js';
+import './vscodeEgyptChatService.js'; // side-effect import: registers the singleton service
+
+export const VSCODE_EGYPT_CHAT_VIEWLET_ID = 'workbench.view.vscodeEgyptChatContainer';
+
+const chatViewIcon = registerIcon('vscode-egypt-chat-view-icon', Codicon.commentDiscussion, localize2('vscodeEgyptChatIcon', 'View icon of the VS Code Egypt AI chat panel.').value);
+
+const VIEW_CONTAINER = Registry.as<IViewContainersRegistry>(ViewContainerExtensions.ViewContainersRegistry).registerViewContainer(
+	{
+		id: VSCODE_EGYPT_CHAT_VIEWLET_ID,
