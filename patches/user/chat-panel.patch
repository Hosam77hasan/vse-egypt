+    </div>
+    <a href="#" id="upgradeLink">Upgrade / Billing</a>
+  </div>
+  <div id="threadPanel"></div>
+  <div id="threadTitle"></div>
+  <div id="pinnedRow"></div>
+  <div style="position:relative; flex:1; display:flex; flex-direction:column; min-height:0;">
+    <div id="dropZone">Drop image here (Innovator model only)</div>
+    <div id="history"></div>
+    <div id="suggestionsRow"></div>
+  </div>
+  <div id="errorBar" class="error" hidden></div>
+  <div id="imagePreviewRow"></div>
+  <div id="inputRow">
+    <div id="agentModeRow">
+      <input type="checkbox" id="agentModeCheckbox" />
+      <label for="agentModeCheckbox">🤖 Agent Mode (multi-file plan, review before applying)</label>
+    </div>
+    <textarea id="input" rows="2" placeholder="Ask VS Code Egypt AI... (@File:path, @Folder:path, @Codebase, drag images for Innovator)"></textarea>
+    <div id="inputControls">
+      <select id="modelSelect"></select>
+      <button id="sendBtn" style="flex:1;">Send</button>
+    </div>
+  </div>
+<script>
+(function() {
+  const vscode = acquireVsCodeApi();
+  const historyEl = document.getElementById('history');
+  const inputEl = document.getElementById('input');
+  const sendBtn = document.getElementById('sendBtn');
+  const errorBar = document.getElementById('errorBar');
+  const modelSelectEl = document.getElementById('modelSelect');
+  const threadTitleEl = document.getElementById('threadTitle');
+  const threadPanelEl = document.getElementById('threadPanel');
+  const threadsBtn = document.getElementById('threadsBtn');
+  const newChatBtn = document.getElementById('newChatBtn');
+  const pinnedRowEl = document.getElementById('pinnedRow');
+  const dropZoneEl = document.getElementById('dropZone');
+  const suggestionsRowEl = document.getElementById('suggestionsRow');
+  const imagePreviewRowEl = document.getElementById('imagePreviewRow');
+  const agentModeCheckbox = document.getElementById('agentModeCheckbox');
+  let streamingEl = null;
+  let pendingImages = [];
+  let currentThreadId = null;
+
+  function renderAgentPlan(plan) {
+    const card = document.createElement('div');
+    card.className = 'agent-plan-card';
+
+    const summary = document.createElement('div');
+    summary.className = 'summary';
+    summary.textContent = plan.summary || 'Agent plan';
+    card.appendChild(summary);
+
+    const fileCheckboxes = [];
+    for (const f of (plan.files || [])) {
+      const row = document.createElement('div');
+      row.className = 'agent-file-row';
+      const cb = document.createElement('input');
+      cb.type = 'checkbox';
+      cb.checked = true;
+      fileCheckboxes.push({ cb, file: f });
+      row.appendChild(cb);
+      const badge = document.createElement('span');
+      badge.className = 'agent-badge';
+      badge.textContent = f.action === 'create' ? 'NEW' : 'EDIT';
+      row.appendChild(badge);
+      const path = document.createElement('span');
+      path.className = 'agent-file-path';
+      path.textContent = f.path;
+      row.appendChild(path);
+      card.appendChild(row);
+    }
+
+    const cmdCheckboxes = [];
+    for (const c of (plan.terminalCommands || [])) {
+      const row = document.createElement('div');
+      row.className = 'agent-cmd-row';
+      const cb = document.createElement('input');
+      cb.type = 'checkbox';
+      cb.checked = true;
+      cmdCheckboxes.push({ cb, cmd: c });
+      row.appendChild(cb);
+      const textWrap = document.createElement('div');
+      const cmdText = document.createElement('div');
+      cmdText.className = 'agent-cmd-text';
+      cmdText.textContent = '$ ' + c.command;
+      textWrap.appendChild(cmdText);
+      const desc = document.createElement('div');
+      desc.className = 'agent-cmd-desc';
+      desc.textContent = c.description || '';
+      textWrap.appendChild(desc);
+      row.appendChild(textWrap);
+      card.appendChild(row);
+    }
+
+    if ((plan.files || []).length === 0 && (plan.terminalCommands || []).length === 0) {
+      const none = document.createElement('div');
+      none.style.opacity = '0.7';
+      none.textContent = 'No file changes or commands needed.';
+      card.appendChild(none);
+    } else {
+      const actions = document.createElement('div');
+      actions.className = 'agent-actions';
+      const applyBtn = document.createElement('button');
+      applyBtn.className = 'agent-apply-btn';
+      applyBtn.textContent = 'Apply Selected';
+      applyBtn.onclick = () => {
+        const planFiles = fileCheckboxes.filter(x => x.cb.checked).map(x => x.file);
+        const planCommands = cmdCheckboxes.filter(x => x.cb.checked).map(x => x.cmd);
+        vscode.postMessage({ type: 'applyAgentPlan', planFiles, planCommands });
+        applyBtn.disabled = true;
+        applyBtn.textContent = 'Applying…';
+      };
+      actions.appendChild(applyBtn);
+      const cancelBtn = document.createElement('button');
+      cancelBtn.className = 'agent-cancel-btn';
+      cancelBtn.textContent = 'Discard';
+      cancelBtn.onclick = () => card.remove();
+      actions.appendChild(cancelBtn);
+      card.appendChild(actions);
+    }
+
+    historyEl.appendChild(card);
+    historyEl.scrollTop = historyEl.scrollHeight;
+  }
+
+  document.getElementById('upgradeLink').addEventListener('click', (e) => {
+    e.preventDefault();
+    vscode.postMessage({ type: 'openBilling' });
+  });
+
+  newChatBtn.addEventListener('click', () => vscode.postMessage({ type: 'newThread' }));
+  threadsBtn.addEventListener('click', () => threadPanelEl.classList.toggle('open'));
+  document.getElementById('pinFileBtn').addEventListener('click', () => vscode.postMessage({ type: 'pinActiveFile' }));
+
+  function renderThreadList(threads) {
+    threadPanelEl.innerHTML = '';
+    for (const t of (threads || [])) {
+      const row = document.createElement('div');
+      row.className = 'thread-row' + (t.id === currentThreadId ? ' active' : '');
+      const label = document.createElement('span');
+      label.textContent = t.title;
+      label.style.overflow = 'hidden';
+      label.style.textOverflow = 'ellipsis';
+      row.appendChild(label);
+      const del = document.createElement('span');
+      del.className = 'del';
+      del.textContent = '✕';
+      del.onclick = (e) => { e.stopPropagation(); vscode.postMessage({ type: 'deleteThread', threadId: t.id }); };
+      row.appendChild(del);
+      row.onclick = () => { vscode.postMessage({ type: 'switchThread', threadId: t.id }); threadPanelEl.classList.remove('open'); };
+      threadPanelEl.appendChild(row);
+    }
+  }
+
+  function renderPinned(pinnedContext) {
+    pinnedRowEl.innerHTML = '';
+    for (const p of (pinnedContext || [])) {
+      const chip = document.createElement('div');
+      chip.className = 'pin-chip';
+      const label = document.createElement('span');
+      label.textContent = '📌 ' + p.label;
+      chip.appendChild(label);
+      const x = document.createElement('span');
+      x.className = 'x';
+      x.textContent = '✕';
+      x.onclick = () => vscode.postMessage({ type: 'unpinContext', pinId: p.id });
+      chip.appendChild(x);
+      pinnedRowEl.appendChild(chip);
+    }
+  }
+
+  function renderActiveThread(thread) {
+    currentThreadId = thread.id;
+    threadTitleEl.textContent = thread.title;
+    renderPinned(thread.pinnedContext);
+    historyEl.innerHTML = '';
+    suggestionsRowEl.innerHTML = '';
+    for (const m of thread.messages) {
+      const div = document.createElement('div');
+      div.className = 'msg ' + m.role;
+      div.textContent = m.content;
+      if (m.images) {
+        for (const img of m.images) {
+          const imgEl = document.createElement('img');
+          imgEl.src = img.dataUrl;
+          div.appendChild(imgEl);
+        }
+      }
+      historyEl.appendChild(div);
+    }
+    historyEl.scrollTop = historyEl.scrollHeight;
+  }
+
+  function renderSuggestions(suggestions) {
+    suggestionsRowEl.innerHTML = '';
+    for (const s of (suggestions || [])) {
+      const chip = document.createElement('button');
+      chip.className = 'suggestion-chip';
+      chip.textContent = s;
+      chip.onclick = () => {
+        if (sendBtn.disabled) return; // a message is already in flight
+        suggestionsRowEl.innerHTML = '';
+        inputEl.value = s;
+        send();
+      };
+      suggestionsRowEl.appendChild(chip);
+    }
+  }
+
+  function renderModelCatalog(models) {
+    modelSelectEl.innerHTML = '';
+    const entries = Object.entries(models || {});
+    if (entries.length === 0) {
+      const opt = document.createElement('option');
+      opt.value = 'driver';
+      opt.textContent = 'السائق (Driver)';
+      modelSelectEl.appendChild(opt);
+      return;
+    }
+    for (const [alias, info] of entries) {
+      const opt = document.createElement('option');
+      opt.value = alias;
+      opt.textContent = info.label + ' (' + info.labelEn + ')';
+      opt.title = info.description;
+      modelSelectEl.appendChild(opt);
+    }
+  }
+
+  function renderImagePreviews() {
+    imagePreviewRowEl.innerHTML = '';
+    pendingImages.forEach((img, i) => {
+      const thumb = document.createElement('div');
+      thumb.className = 'img-thumb';
+      const imgEl = document.createElement('img');
+      imgEl.src = img.dataUrl;
+      thumb.appendChild(imgEl);
+      const rm = document.createElement('div');
+      rm.className = 'rm';
+      rm.textContent = '✕';
+      rm.onclick = () => { pendingImages.splice(i, 1); renderImagePreviews(); };
+      thumb.appendChild(rm);
+      imagePreviewRowEl.appendChild(thumb);
+    });
+  }
+
+  // Drag-and-drop image support — pendingImages carries into the next sendMessage.
+  // Backend rejects these unless the Innovator model is selected (see chat.js's
+  // multimodal_not_supported guard); the dropzone hint text says so up front.
+  ['dragenter', 'dragover'].forEach(evt => {
+    document.body.addEventListener(evt, (e) => {
+      if (e.dataTransfer && Array.from(e.dataTransfer.types).includes('Files')) {
+        e.preventDefault();
+        dropZoneEl.classList.add('active');
+      }
+    });
+  });
+  ['dragleave', 'drop'].forEach(evt => {
+    document.body.addEventListener(evt, () => dropZoneEl.classList.remove('active'));
+  });
+  document.body.addEventListener('drop', (e) => {
+    if (!e.dataTransfer || !e.dataTransfer.files || e.dataTransfer.files.length === 0) return;
+    e.preventDefault();
+    for (const file of Array.from(e.dataTransfer.files)) {
+      if (!file.type.startsWith('image/')) continue;
+      const reader = new FileReader();
+      reader.onload = () => {
+        pendingImages.push({ dataUrl: reader.result, name: file.name });
+        renderImagePreviews();
+      };
+      reader.readAsDataURL(file);
+    }
+  });
+
+  function send() {
+    const text = inputEl.value.trim();
+    if (!text && pendingImages.length === 0) return;
+    errorBar.hidden = true;
+    suggestionsRowEl.innerHTML = '';
+    vscode.postMessage({ type: 'sendMessage', text, model: modelSelectEl.value || 'driver', images: pendingImages, agentMode: agentModeCheckbox.checked });
+    inputEl.value = '';
+    pendingImages = [];
+    renderImagePreviews();
+    sendBtn.disabled = true;
+  }
+
+  sendBtn.addEventListener('click', send);
+  inputEl.addEventListener('keydown', (e) => {
+    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
+  });
+
+  window.addEventListener('message', (event) => {
+    const msg = event.data;
+    switch (msg.type) {
+      case 'setActiveThread':
+        renderActiveThread(msg.thread);
+        break;
+      case 'setThreadList':
+        renderThreadList(msg.threads);
+        break;
+      case 'setModelCatalog':
+        renderModelCatalog(msg.models);
+        break;
+      case 'streamStart':
+        streamingEl = document.createElement('div');
+        streamingEl.className = 'msg assistant streaming';
+        historyEl.appendChild(streamingEl);
+        historyEl.scrollTop = historyEl.scrollHeight;
+        break;
+      case 'appendDelta':
+        if (streamingEl) {
+          streamingEl.textContent += msg.text;
+          historyEl.scrollTop = historyEl.scrollHeight;
+        }
+        break;
+      case 'streamEnd':
+        if (streamingEl) streamingEl.classList.remove('streaming');
+        streamingEl = null;
+        sendBtn.disabled = false;
+        break;
+      case 'agentPlanning': {
+        const planningEl = document.createElement('div');
+        planningEl.className = 'msg assistant';
+        planningEl.id = 'agentPlanningIndicator';
+        planningEl.textContent = 'Planning…';
+        historyEl.appendChild(planningEl);
+        historyEl.scrollTop = historyEl.scrollHeight;
+        break;
+      }
+      case 'showAgentPlan': {
+        const indicator = document.getElementById('agentPlanningIndicator');
+        if (indicator) indicator.remove();
+        renderAgentPlan(msg.plan);
+        sendBtn.disabled = false;
+        break;
+      }
+      case 'agentPlanApplied': {
+        const note = document.createElement('div');
+        note.className = 'msg assistant';
+        note.textContent = 'Applied ' + msg.appliedFileCount + ' file(s) and pasted ' + msg.appliedCommandCount + ' command(s) into the terminal (review before running).';
+        historyEl.appendChild(note);
+        historyEl.scrollTop = historyEl.scrollHeight;
+        break;
+      }
+      case 'setSuggestions':
+        renderSuggestions(msg.suggestions);
+        break;
+      case 'error': {
+        const indicator = document.getElementById('agentPlanningIndicator');
+        if (indicator) indicator.remove();
+        errorBar.textContent = msg.error;
+        errorBar.hidden = false;
+        if (streamingEl) streamingEl.remove();
+        streamingEl = null;
+        sendBtn.disabled = false;
+        break;
+      }
+    }
+  });
+
+  vscode.postMessage({ type: 'ready' });
+  renderModelCatalog({});
+})();
+</script>
+</body>
+</html>`;
+	}
+}
