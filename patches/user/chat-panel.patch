+/*---------------------------------------------------------------------------------------------
+ *  VS Code Egypt — proprietary addition. Not part of upstream Microsoft/VSCodium source.
+ *
+ *  A native (non-extension) webview panel, following the same IWebviewService pattern used
+ *  by the built-in Getting Started walkthrough (src/vs/workbench/contrib/welcomeGettingStarted).
+ *  We deliberately do NOT use the extension-contributed WebviewViewPane machinery — that
+ *  requires an extension host round-trip and is designed for third-party extensions, not a
+ *  first-party built-in feature.
+ *--------------------------------------------------------------------------------------------*/
+
+import { ViewPane, IViewPaneOptions } from '../../../browser/parts/views/viewPane.js';
+import { IWebviewElement, IWebviewService, WebviewMessageReceivedEvent } from '../../webview/browser/webview.js';
+import { IInstantiationService } from '../../../../platform/instantiation/common/instantiation.js';
+import { IContextKeyService } from '../../../../platform/contextkey/common/contextkey.js';
+import { IContextMenuService } from '../../../../platform/contextview/browser/contextView.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { IViewDescriptorService } from '../../../common/views.js';
+import { IOpenerService } from '../../../../platform/opener/common/opener.js';
+import { IThemeService } from '../../../../platform/theme/common/themeService.js';
+import { IHoverService } from '../../../../platform/hover/browser/hover.js';
+import { IKeybindingService } from '../../../../platform/keybinding/common/keybinding.js';
+import { getActiveWindow } from '../../../../base/browser/dom.js';
+import { IVSCodeEgyptChatService, IChatThread, VSCodeEgyptModelAlias, IVSCodeEgyptModelInfo, IChatImageAttachment } from './vscodeEgyptChatService.js';
+import { DisposableStore } from '../../../../base/common/lifecycle.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { OPEN_BILLING_COMMAND_ID } from '../../vscodeEgyptStatusbar/browser/statusbarEntry.contribution.js';
+import { IVSCodeEgyptContextResolverService } from '../../vscodeEgyptWorkspaceIndex/browser/workspaceIndex.contribution.js';
+import { IEditorService } from '../../../services/editor/common/editorService.js';
+import { IFileService } from '../../../../platform/files/common/files.js';
+import { IWorkspaceContextService } from '../../../../platform/workspace/common/workspace.js';
+import { relativePath } from '../../../../base/common/resources.js';
+import { IVSCodeEgyptAgentService, IAgentPlan, IAgentPlanFile, IAgentPlanCommand } from '../../vscodeEgyptAgent/browser/agentService.js';
+
+interface WebviewToHostMessage {
+	type: 'sendMessage' | 'ready' | 'openBilling' | 'newThread' | 'switchThread' | 'deleteThread' | 'renameThread' | 'unpinContext' | 'pinActiveFile' | 'applyAgentPlan';
+	text?: string;
+	model?: VSCodeEgyptModelAlias;
+	images?: IChatImageAttachment[];
+	threadId?: string;
+	title?: string;
+	pinId?: string;
+	agentMode?: boolean;
+	planFiles?: IAgentPlanFile[];
+	planCommands?: IAgentPlanCommand[];
+}
+
+interface HostToWebviewMessage {
+	type: 'appendDelta' | 'setActiveThread' | 'setThreadList' | 'streamStart' | 'streamEnd' | 'error' | 'setModelCatalog' | 'showAgentPlan' | 'agentPlanApplied' | 'agentPlanning' | 'setSuggestions';
+	text?: string;
+	thread?: IChatThread;
+	threads?: IChatThread[];
+	error?: string;
+	models?: Record<string, IVSCodeEgyptModelInfo>;
+	plan?: IAgentPlan;
+	appliedFileCount?: number;
+	appliedCommandCount?: number;
+	suggestions?: string[];
+}
+
+export class VSCodeEgyptChatViewPane extends ViewPane {
+
+	static readonly ID = 'workbench.view.vscodeEgyptChat';
+
+	private webview: IWebviewElement | undefined;
+	private readonly webviewDisposables = this._register(new DisposableStore());
+
+	constructor(
+		options: IViewPaneOptions,
+		@IKeybindingService keybindingService: IKeybindingService,
+		@IContextMenuService contextMenuService: IContextMenuService,
+		@IConfigurationService configurationService: IConfigurationService,
+		@IContextKeyService contextKeyService: IContextKeyService,
+		@IViewDescriptorService viewDescriptorService: IViewDescriptorService,
+		@IInstantiationService instantiationService: IInstantiationService,
+		@IOpenerService openerService: IOpenerService,
+		@IThemeService themeService: IThemeService,
+		@IHoverService hoverService: IHoverService,
+		@IWebviewService private readonly webviewService: IWebviewService,
+		@IVSCodeEgyptChatService private readonly chatService: IVSCodeEgyptChatService,
+		@ICommandService private readonly commandService: ICommandService,
+		@IVSCodeEgyptContextResolverService private readonly contextResolverService: IVSCodeEgyptContextResolverService,
+		@IEditorService private readonly editorService: IEditorService,
+		@IFileService private readonly fileService: IFileService,
+		@IWorkspaceContextService private readonly workspaceContextService: IWorkspaceContextService,
+		@IVSCodeEgyptAgentService private readonly agentService: IVSCodeEgyptAgentService,
+	) {
+		super(options, keybindingService, contextMenuService, configurationService, contextKeyService, viewDescriptorService, instantiationService, openerService, themeService, hoverService);
+	}
+
+	protected override renderBody(container: HTMLElement): void {
+		super.renderBody(container);
+
+		const webview = this.webviewDisposables.add(this.webviewService.createWebviewElement({
+			title: 'VS Code Egypt Chat',
+			options: { disableServiceWorker: true },
+			// No localResourceRoots: our HTML/CSS/JS is inlined below rather than loaded
+			// from disk, so we don't need to grant filesystem access to the webview.
+			contentOptions: { allowScripts: true },
+			extension: undefined,
+		}));
+		this.webview = webview;
+
+		webview.mountTo(container, getActiveWindow());
+		webview.setHtml(this.getWebviewHtml());
+
+		this.webviewDisposables.add(webview.onMessage((e: WebviewMessageReceivedEvent) => this.handleWebviewMessage(e.message as WebviewToHostMessage)));
+
+		this.webviewDisposables.add(this.chatService.onDidChangeActiveThread((thread: IChatThread) => {
+			this.postToWebview({ type: 'setActiveThread', thread });
+		}));
+		this.webviewDisposables.add(this.chatService.onDidChangeThreadList((threads: IChatThread[]) => {
+			this.postToWebview({ type: 'setThreadList', threads });
+		}));
+	}
+
+	protected override layoutBody(height: number, width: number): void {
+		super.layoutBody(height, width);
+		// No explicit layout call needed: mountTo() makes the webview's iframe a normal
+		// DOM child of `container` (not an IOverlayWebview absolutely positioned over
+		// another element), so it sizes via ordinary CSS.
+	}
+
+	private async handleWebviewMessage(message: WebviewToHostMessage): Promise<void> {
+		switch (message.type) {
+			case 'ready':
+				this.postToWebview({ type: 'setActiveThread', thread: this.chatService.getActiveThread() });
+				this.postToWebview({ type: 'setThreadList', threads: this.chatService.listThreads() });
+				this.chatService.getModelCatalog().then(models => this.postToWebview({ type: 'setModelCatalog', models }));
+				break;
+
+			case 'openBilling':
+				await this.commandService.executeCommand(OPEN_BILLING_COMMAND_ID);
+				break;
+
+			case 'newThread':
+				this.chatService.createThread();
+				break;
+
+			case 'switchThread':
+				if (message.threadId) {
+					this.chatService.switchThread(message.threadId);
+				}
+				break;
+
+			case 'deleteThread':
+				if (message.threadId) {
+					this.chatService.deleteThread(message.threadId);
+				}
+				break;
+
+			case 'renameThread':
+				if (message.threadId && message.title) {
+					this.chatService.renameThread(message.threadId, message.title);
+				}
+				break;
+
+			case 'unpinContext':
+				if (message.pinId) {
+					this.chatService.unpinContext(message.pinId);
+				}
+				break;
+
+			case 'pinActiveFile':
+				await this.pinActiveFile();
+				break;
+
+			case 'sendMessage': {
+				if (!message.text?.trim() && !(message.images && message.images.length > 0)) {
+					return;
+				}
+
+				if (message.agentMode) {
+					this.postToWebview({ type: 'agentPlanning' });
+					try {
+						const plan = await this.agentService.requestPlan(message.text ?? '', message.model ?? 'leader');
+						this.postToWebview({ type: 'showAgentPlan', plan });
+					} catch (err) {
+						this.postToWebview({ type: 'error', error: err instanceof Error ? err.message : 'Agent planning failed.' });
+					}
+					break;
+				}
+
+				this.postToWebview({ type: 'streamStart' });
+				try {
+					const resolvedItems = await this.contextResolverService.resolveMentions(message.text ?? '');
+					const resolvedContext = resolvedItems.length > 0
+						? resolvedItems.map(i => i.content).join('\n\n')
+						: undefined;
+
+					await this.chatService.sendMessage(message.text ?? '', message.model ?? 'driver', (delta) => {
+						this.postToWebview({ type: 'appendDelta', text: delta });
+					}, {
+						resolvedContext,
+						images: message.images,
+						onSuggestions: (suggestions) => this.postToWebview({ type: 'setSuggestions', suggestions }),
+					});
+					this.postToWebview({ type: 'streamEnd' });
+				} catch (err) {
+					this.postToWebview({ type: 'error', error: err instanceof Error ? err.message : 'Unknown error contacting VS Code Egypt AI service.' });
+				}
+				break;
+			}
+
+			case 'applyAgentPlan': {
+				try {
+					await this.agentService.applyPlan(message.planFiles ?? [], message.planCommands ?? []);
+					this.postToWebview({
+						type: 'agentPlanApplied',
+						appliedFileCount: message.planFiles?.length ?? 0,
+						appliedCommandCount: message.planCommands?.length ?? 0,
+					});
+				} catch (err) {
+					this.postToWebview({ type: 'error', error: err instanceof Error ? err.message : 'Failed to apply the plan.' });
+				}
+				break;
+			}
+		}
+	}
+
+	private async pinActiveFile(): Promise<void> {
+		const resource = this.editorService.activeEditor?.resource;
+		if (!resource) {
+			return;
+		}
+		try {
+			const content = await this.fileService.readFile(resource);
+			const folders = this.workspaceContextService.getWorkspace().folders;
+			const label = folders.length > 0 ? (relativePath(folders[0].uri, resource) ?? resource.path) : resource.path;
+			this.chatService.pinContext({
+				label,
+				content: `File: ${label}\n\`\`\`\n${content.value.toString()}\n\`\`\``,
+			});
+		} catch {
+			// unreadable/binary active editor — silently no-op, same reasoning as
+			// the @File resolver in workspaceIndex.contribution.ts
+		}
+	}
+
+	private postToWebview(message: HostToWebviewMessage): void {
+		this.webview?.postMessage(message);
+	}
+
+	// The chat markup itself is intentionally minimal here — swap for a bundled React
+	// build (same approach as the Ctrl+K widget) once the UI needs to grow beyond a
+	// simple scroll-and-input loop. Kept inline + framework-free so this file has zero
+	// build-step dependency.
+	private getWebviewHtml(): string {
+		return /* html */ `<!DOCTYPE html>
+<html>
+<head>
+<meta charset="UTF-8">
+<style>
+  :root { color-scheme: light dark; }
+  body { margin:0; padding:0; font-family: var(--vscode-font-family, sans-serif); background: var(--vscode-sideBar-background, #C6FF00); color: var(--vscode-sideBar-foreground, #000); display:flex; flex-direction:column; height:100vh; }
+  #topBar { display:flex; justify-content:space-between; align-items:center; padding:6px 10px; border-bottom:1px solid rgba(0,0,0,0.15); font-size:11px; }
+  #topBarLeft { display:flex; align-items:center; gap:6px; }
+  #newChatBtn, #threadsBtn, #pinFileBtn { border:none; background:rgba(0,0,0,0.08); color:#000; border-radius:4px; padding:3px 8px; cursor:pointer; font-size:11px; font-weight:700; }
+  #upgradeLink { color:#000; font-weight:700; text-decoration:underline; cursor:pointer; }
+  #threadTitle { font-size:11px; font-weight:700; padding:6px 10px; opacity:0.75; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
+  #threadPanel { display:none; max-height:160px; overflow-y:auto; border-bottom:1px solid rgba(0,0,0,0.15); }
+  #threadPanel.open { display:block; }
+  .thread-row { display:flex; justify-content:space-between; align-items:center; padding:6px 10px; font-size:12px; cursor:pointer; }
+  .thread-row:hover { background:rgba(0,0,0,0.06); }
+  .thread-row.active { background:rgba(0,0,0,0.1); font-weight:700; }
+  .thread-row .del { opacity:0.5; cursor:pointer; padding:0 4px; }
+  #pinnedRow { display:flex; flex-wrap:wrap; gap:4px; padding:6px 10px; border-bottom:1px solid rgba(0,0,0,0.1); }
+  #pinnedRow:empty { display:none; }
+  .pin-chip { background:#000; color:#C6FF00; font-size:10px; padding:2px 8px; border-radius:10px; display:flex; align-items:center; gap:4px; }
+  .pin-chip .x { cursor:pointer; opacity:0.7; }
+  #history { flex:1; overflow-y:auto; padding:12px; }
+  .msg { margin-bottom:10px; padding:8px 10px; border-radius:6px; font-size:13px; line-height:1.4; white-space:pre-wrap; word-break:break-word; }
+  .msg.user { background: rgba(0,0,0,0.08); text-align:right; }
+  .msg.assistant { background: rgba(0,0,0,0.04); }
+  .msg.streaming::after { content:'▍'; animation: blink 1s step-start infinite; }
+  #suggestionsRow { display:flex; flex-wrap:wrap; gap:6px; padding:0 12px 10px; }
+  .suggestion-chip {
+    background:#000; color:#C6FF00; border:1px solid #C6FF00; border-radius:16px;
+    padding:6px 14px; font-size:11.5px; cursor:pointer; font-family:inherit;
+    transition: background 0.15s, color 0.15s;
+  }
+  .suggestion-chip:hover { background:#C6FF00; color:#000; }
+  .suggestion-chip:disabled { opacity:0.4; cursor:default; }
+  .msg img { max-width:100%; border-radius:4px; margin-top:6px; display:block; }
+  @keyframes blink { 50% { opacity:0; } }
+  #dropZone { position:absolute; inset:0; background:rgba(198,255,0,0.15); border:2px dashed #000; display:none; align-items:center; justify-content:center; font-weight:700; pointer-events:none; z-index:5; }
+  #dropZone.active { display:flex; }
+  #imagePreviewRow { display:flex; gap:6px; padding:0 10px; flex-wrap:wrap; }
+  .img-thumb { position:relative; width:40px; height:40px; }
+  .img-thumb img { width:100%; height:100%; object-fit:cover; border-radius:4px; }
+  .img-thumb .rm { position:absolute; top:-4px; right:-4px; background:#000; color:#fff; border-radius:50%; width:14px; height:14px; font-size:9px; display:flex; align-items:center; justify-content:center; cursor:pointer; }
+  #inputRow { display:flex; flex-direction:column; gap:6px; padding:10px; border-top:1px solid rgba(0,0,0,0.15); position:relative; }
+  #input { resize:none; border:1px solid rgba(0,0,0,0.25); border-radius:6px; padding:8px; font-family:inherit; font-size:13px; background:#fff; color:#000; }
+  #inputControls { display:flex; gap:6px; }
+  #modelSelect { border:1px solid rgba(0,0,0,0.25); border-radius:6px; padding:6px 8px; font-family:inherit; font-size:12px; background:#fff; color:#000; }
+  #sendBtn { border:none; border-radius:6px; padding:0 14px; background:#000; color:#C6FF00; font-weight:700; cursor:pointer; }
+  #sendBtn:disabled { opacity:0.4; cursor:default; }
+  .error { color:#a00; font-size:12px; padding:6px 12px; }
+  #agentModeRow { display:flex; align-items:center; gap:6px; font-size:11px; padding:0 2px; }
+  .agent-plan-card { background:#000; color:#C6FF00; border-radius:8px; padding:10px; margin-bottom:10px; font-size:12px; }
+  .agent-plan-card .summary { font-weight:700; margin-bottom:8px; }
+  .agent-file-row, .agent-cmd-row { display:flex; align-items:flex-start; gap:6px; padding:4px 0; border-top:1px solid #222; }
+  .agent-file-row:first-of-type, .agent-cmd-row:first-of-type { border-top:none; }
+  .agent-badge { font-size:9px; padding:1px 6px; border-radius:8px; background:#C6FF00; color:#000; font-weight:700; flex-shrink:0; }
+  .agent-file-path { font-family:monospace; font-size:11px; word-break:break-all; }
+  .agent-cmd-text { font-family:monospace; font-size:11px; }
+  .agent-cmd-desc { font-size:10px; opacity:0.7; }
+  .agent-actions { display:flex; gap:8px; margin-top:10px; }
+  .agent-actions button { flex:1; border:none; border-radius:5px; padding:6px; font-weight:700; cursor:pointer; font-size:11px; }
