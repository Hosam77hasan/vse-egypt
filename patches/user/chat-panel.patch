@@ -0,0 +1,399 @@
+/*---------------------------------------------------------------------------------------------
+ *  VS Code Egypt — proprietary addition. Not part of upstream Microsoft/VSCodium source.
+ *
+ *  Multi-thread chat. Design note: threads and their messages are persisted CLIENT-SIDE
+ *  (IStorageService, WORKSPACE scope) rather than synced to the backend. This was a
+ *  deliberate scope choice — it delivers genuine multi-thread capability (new chat,
+ *  switch, rename, delete, independent history per thread) without a larger backend
+ *  rearchitecture of the already-tested /v1/chat flow. Upgrade path: add thread
+ *  CRUD endpoints backed by the `chat_threads`/`chat_messages` tables and sync on
+ *  change — the interface below wouldn't need to change, only loadThreads/persistThreads.
+ *--------------------------------------------------------------------------------------------*/
+
+import { createDecorator } from '../../../../platform/instantiation/common/instantiation.js';
+import { registerSingleton, InstantiationType } from '../../../../platform/instantiation/common/extensions.js';
+import { IStorageService, StorageScope, StorageTarget } from '../../../../platform/storage/common/storage.js';
+import { IProductService } from '../../../../platform/product/common/productService.js';
+import { Emitter, Event } from '../../../../base/common/event.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { ACCESS_TOKEN_STORAGE_KEY } from '../../vscodeEgyptLicense/browser/licenseGate.contribution.js';
+
+// Must match vse-backend/routes/chat.js's SUGGESTIONS_SENTINEL exactly.
+const SUGGESTIONS_SENTINEL = '%%%SUGGESTIONS%%%';
+
+/**
+ * Wraps a raw onDelta callback so that if/when the model emits the suggestions
+ * sentinel at the end of its response, none of it (or the JSON after it) ever
+ * reaches the visible chat bubble — including the awkward case where the sentinel
+ * arrives split across multiple small stream chunks. Verified against that exact
+ * case (and 3 others: whole-chunk sentinel, no sentinel at all, malformed JSON)
+ * with a standalone test before porting this logic here.
+ */
+function createSuggestionsSentinelProcessor(onVisibleDelta: (delta: string) => void) {
+	let rawText = '';
+	let flushedLength = 0;
+
+	return {
+		processDelta(delta: string): void {
+			rawText += delta;
+			const sentinelIdx = rawText.indexOf(SUGGESTIONS_SENTINEL);
+			if (sentinelIdx !== -1) {
+				if (flushedLength < sentinelIdx) {
+					onVisibleDelta(rawText.slice(flushedLength, sentinelIdx));
+					flushedLength = sentinelIdx;
+				}
+				return;
+			}
+			// No sentinel found yet — flush everything except a safety tail as long as
+			// the sentinel itself, in case it's split across this delta and the next.
+			const safeFlushEnd = Math.max(flushedLength, rawText.length - SUGGESTIONS_SENTINEL.length);
+			if (safeFlushEnd > flushedLength) {
+				onVisibleDelta(rawText.slice(flushedLength, safeFlushEnd));
+				flushedLength = safeFlushEnd;
+			}
+		},
+		finalize(): { cleanText: string; suggestions: string[] } {
+			const sentinelIdx = rawText.indexOf(SUGGESTIONS_SENTINEL);
+			if (sentinelIdx === -1) {
+				if (flushedLength < rawText.length) {
+					onVisibleDelta(rawText.slice(flushedLength));
+				}
+				return { cleanText: rawText, suggestions: [] };
+			}
+			const jsonPart = rawText.slice(sentinelIdx + SUGGESTIONS_SENTINEL.length).trim();
+			let suggestions: string[] = [];
+			try {
+				const parsed = JSON.parse(jsonPart);
+				if (Array.isArray(parsed)) {
+					suggestions = parsed.filter((s): s is string => typeof s === 'string').slice(0, 3);
+				}
+			} catch {
+				// malformed JSON from the model — graceful degradation, no suggestions shown
+			}
+			return { cleanText: rawText.slice(0, sentinelIdx), suggestions };
+		},
+	};
+}
+
+export interface IChatImageAttachment {
+	dataUrl: string; // "data:image/png;base64,...."
+	name: string;
+}
+
+export interface IChatMessage {
+	role: 'user' | 'assistant';
+	content: string;
+	images?: IChatImageAttachment[];
+}
+
+export interface IPinnedContextItem {
+	id: string;
+	label: string;
+	content: string;
+}
+
+export interface IChatThread {
+	id: string;
+	title: string;
+	createdAt: number;
+	updatedAt: number;
+	messages: IChatMessage[];
+	pinnedContext: IPinnedContextItem[];
+}
+
+export type VSCodeEgyptModelAlias = 'driver' | 'leader' | 'innovator';
+
+export interface IVSCodeEgyptModelInfo {
+	label: string;
+	labelEn: string;
+	description: string;
+}
+
+export const IVSCodeEgyptChatService = createDecorator<IVSCodeEgyptChatService>('vscodeEgyptChatService');
+
+export interface IVSCodeEgyptChatService {
+	readonly _serviceBrand: undefined;
+	readonly onDidChangeActiveThread: Event<IChatThread>;
+	readonly onDidChangeThreadList: Event<IChatThread[]>;
+
+	listThreads(): IChatThread[];
+	getActiveThread(): IChatThread;
+	createThread(): IChatThread;
+	switchThread(threadId: string): void;
+	deleteThread(threadId: string): void;
+	renameThread(threadId: string, title: string): void;
+
+	pinContext(item: { label: string; content: string }): void;
+	unpinContext(itemId: string): void;
+
+	sendMessage(text: string, model: VSCodeEgyptModelAlias, onDelta: (delta: string) => void, options?: { resolvedContext?: string; images?: IChatImageAttachment[]; onSuggestions?: (suggestions: string[]) => void }): Promise<void>;
+	getModelCatalog(): Promise<Record<string, IVSCodeEgyptModelInfo>>;
+}
+
+const THREADS_STORAGE_KEY = 'vscodeEgypt.chatThreads';
+const ACTIVE_THREAD_STORAGE_KEY = 'vscodeEgypt.activeChatThreadId';
+const MAX_HISTORY_MESSAGES = 200; // cap growth of a single thread's persisted transcript
+const DEFAULT_API_BASE = 'https://api.vscode-egypt.example/v1';
+
+function generateId(): string {
+	return `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;
+}
+
+function makeEmptyThread(): IChatThread {
+	const now = Date.now();
+	return { id: generateId(), title: 'New Chat', createdAt: now, updatedAt: now, messages: [], pinnedContext: [] };
+}
+
+export class VSCodeEgyptChatService extends Disposable implements IVSCodeEgyptChatService {
+
+	declare readonly _serviceBrand: undefined;
+
+	private readonly _onDidChangeActiveThread = this._register(new Emitter<IChatThread>());
+	readonly onDidChangeActiveThread: Event<IChatThread> = this._onDidChangeActiveThread.event;
+
+	private readonly _onDidChangeThreadList = this._register(new Emitter<IChatThread[]>());
+	readonly onDidChangeThreadList: Event<IChatThread[]> = this._onDidChangeThreadList.event;
+
+	private threads: IChatThread[] = [];
+	private activeThreadId: string;
+
+	constructor(
+		@IStorageService private readonly storageService: IStorageService,
+		@IProductService private readonly productService: IProductService,
+	) {
+		super();
+		this.threads = this.loadThreads();
+		if (this.threads.length === 0) {
+			this.threads = [makeEmptyThread()];
+		}
+		const storedActiveId = this.storageService.get(ACTIVE_THREAD_STORAGE_KEY, StorageScope.WORKSPACE);
+		this.activeThreadId = (storedActiveId && this.threads.some(t => t.id === storedActiveId))
+			? storedActiveId
+			: this.threads[0].id;
+	}
+
+	listThreads(): IChatThread[] {
+		return [...this.threads].sort((a, b) => b.updatedAt - a.updatedAt);
+	}
+
+	getActiveThread(): IChatThread {
+		return this.threads.find(t => t.id === this.activeThreadId) ?? this.threads[0];
+	}
+
+	createThread(): IChatThread {
+		const thread = makeEmptyThread();
+		this.threads.push(thread);
+		this.activeThreadId = thread.id;
+		this.persistThreads();
+		this.storageService.store(ACTIVE_THREAD_STORAGE_KEY, thread.id, StorageScope.WORKSPACE, StorageTarget.MACHINE);
+		this._onDidChangeThreadList.fire(this.listThreads());
+		this._onDidChangeActiveThread.fire(thread);
+		return thread;
+	}
+
+	switchThread(threadId: string): void {
+		const thread = this.threads.find(t => t.id === threadId);
+		if (!thread) {
+			return;
+		}
+		this.activeThreadId = threadId;
+		this.storageService.store(ACTIVE_THREAD_STORAGE_KEY, threadId, StorageScope.WORKSPACE, StorageTarget.MACHINE);
+		this._onDidChangeActiveThread.fire(thread);
+	}
+
+	deleteThread(threadId: string): void {
+		this.threads = this.threads.filter(t => t.id !== threadId);
+		if (this.threads.length === 0) {
+			this.threads = [makeEmptyThread()];
+		}
+		if (this.activeThreadId === threadId) {
+			this.activeThreadId = this.threads[0].id;
+			this._onDidChangeActiveThread.fire(this.threads[0]);
+		}
+		this.persistThreads();
+		this._onDidChangeThreadList.fire(this.listThreads());
+	}
+
+	renameThread(threadId: string, title: string): void {
+		const thread = this.threads.find(t => t.id === threadId);
+		if (!thread) {
+			return;
+		}
+		thread.title = title.slice(0, 80);
+		thread.updatedAt = Date.now();
+		this.persistThreads();
+		this._onDidChangeThreadList.fire(this.listThreads());
+	}
+
+	pinContext(item: { label: string; content: string }): void {
+		const thread = this.getActiveThread();
+		// Avoid pinning the exact same content twice (e.g. re-mentioning the same @File).
+		if (thread.pinnedContext.some(p => p.content === item.content)) {
+			return;
+		}
+		thread.pinnedContext.push({ id: generateId(), label: item.label, content: item.content });
+		thread.updatedAt = Date.now();
+		this.persistThreads();
+		this._onDidChangeActiveThread.fire(thread);
+	}
+
+	unpinContext(itemId: string): void {
+		const thread = this.getActiveThread();
+		thread.pinnedContext = thread.pinnedContext.filter(p => p.id !== itemId);
+		this.persistThreads();
+		this._onDidChangeActiveThread.fire(thread);
+	}
+
+	async getModelCatalog(): Promise<Record<string, IVSCodeEgyptModelInfo>> {
+		const accessToken = this.storageService.get(ACCESS_TOKEN_STORAGE_KEY, StorageScope.APPLICATION);
+		if (!accessToken) {
+			return {};
+		}
+		const apiBase = this.getApiBase();
+		try {
+			const response = await fetch(`${apiBase}/models`, {
+				headers: { 'Authorization': `Bearer ${accessToken}` },
+			});
+			if (!response.ok) {
+				return {};
+			}
+			const data = await response.json() as { models: Record<string, IVSCodeEgyptModelInfo> };
+			return data.models;
+		} catch {
+			return {};
+		}
+	}
+
+	async sendMessage(text: string, model: VSCodeEgyptModelAlias, onDelta: (delta: string) => void, options?: { resolvedContext?: string; images?: IChatImageAttachment[]; onSuggestions?: (suggestions: string[]) => void }): Promise<void> {
+		const accessToken = this.storageService.get(ACCESS_TOKEN_STORAGE_KEY, StorageScope.APPLICATION);
+		if (!accessToken) {
+			throw new Error('Not signed in. Please sign in to VS Code Egypt to use AI chat.');
+		}
+
+		const thread = this.getActiveThread();
+		this.appendMessage(thread, { role: 'user', content: text, images: options?.images });
+
+		const apiBase = this.getApiBase();
+
+		// Build the outgoing payload: pinned context + @-mention-resolved context are
+		// folded into the FINAL user message only (not persisted into history) — same
+		// reasoning as before: resending a growing pile of file dumps on every future
+		// turn would compound token cost across the whole thread from here on.
+		const pinnedText = thread.pinnedContext.length > 0
+			? thread.pinnedContext.map(p => p.content).join('\n\n')
+			: '';
+		const extraContext = [pinnedText, options?.resolvedContext].filter(Boolean).join('\n\n');
+
+		const outgoingMessages: { role: string; content: string | Array<{ type: string; text?: string; image_url?: { url: string } }> }[] =
+			thread.messages.map(m => ({ role: m.role, content: m.content }));
+
+		if (outgoingMessages.length > 0) {
+			const lastIndex = outgoingMessages.length - 1;
+			const last = thread.messages[lastIndex];
+			const textContent = extraContext ? `${extraContext}\n\n${last.content}` : last.content;
+
+			if (last.images && last.images.length > 0) {
+				// Multimodal shape (OpenAI-compatible content-parts array) — the backend
+				// only forwards this upstream when model === 'innovator' (see chat.js's
+				// multimodal_not_supported guard); driver/leader would reject it.
+				outgoingMessages[lastIndex] = {
+					role: last.role,
+					content: [
+						{ type: 'text', text: textContent },
+						...last.images.map(img => ({ type: 'image_url', image_url: { url: img.dataUrl } })),
+					],
+				};
+			} else {
+				outgoingMessages[lastIndex] = { role: last.role, content: textContent };
+			}
+		}
+
+		const response = await fetch(`${apiBase}/chat`, {
+			method: 'POST',
+			headers: {
+				'Content-Type': 'application/json',
+				'Authorization': `Bearer ${accessToken}`,
+			},
+			body: JSON.stringify({ model, messages: outgoingMessages, suggestFollowups: true }),
+		});
+
+		if (!response.ok || !response.body) {
+			const errText = await response.text().catch(() => '');
+			throw new Error(`AI service error (${response.status}): ${errText || 'no details'}`);
+		}
+
+		const reader = response.body.getReader();
+		const decoder = new TextDecoder();
+
+		const sentinelProcessor = createSuggestionsSentinelProcessor(onDelta);
+
+		while (true) {
+			const { done, value } = await reader.read();
+			if (done) {
+				break;
+			}
+			const chunk = decoder.decode(value, { stream: true });
+			for (const line of chunk.split('\n')) {
+				if (!line.startsWith('data: ')) {
+					continue;
+				}
+				const payload = line.slice(6).trim();
+				if (payload === '[DONE]') {
+					continue;
+				}
+				try {
+					const parsed = JSON.parse(payload) as { choices?: { delta?: { content?: string } }[] };
+					const delta = parsed.choices?.[0]?.delta?.content;
+					if (delta) {
+						sentinelProcessor.processDelta(delta);
+					}
+				} catch {
+					// partial JSON fragment split across a chunk boundary — the next
+					// chunk's concatenation resolves this; nothing to do here.
+				}
+			}
+		}
+
+		const { cleanText, suggestions } = sentinelProcessor.finalize();
+		this.appendMessage(thread, { role: 'assistant', content: cleanText });
+		if (suggestions.length > 0) {
+			options?.onSuggestions?.(suggestions);
+		}
+
+		// First user message in a fresh thread becomes its title, truncated — same
+		// UX shorthand Cursor/Windsurf/ChatGPT all use for auto-naming new threads.
+		if (thread.title === 'New Chat' && text.trim()) {
+			thread.title = text.trim().slice(0, 60);
+			this._onDidChangeThreadList.fire(this.listThreads());
+		}
+	}
+
+	private getApiBase(): string {
+		return (this.productService as unknown as { vscodeEgyptLicenseApiBaseUrl?: string }).vscodeEgyptLicenseApiBaseUrl ?? DEFAULT_API_BASE;
+	}
+
+	private appendMessage(thread: IChatThread, message: IChatMessage): void {
+		thread.messages = [...thread.messages, message].slice(-MAX_HISTORY_MESSAGES);
+		thread.updatedAt = Date.now();
+		this.persistThreads();
+		this._onDidChangeActiveThread.fire(thread);
+	}
+
+	private loadThreads(): IChatThread[] {
+		const raw = this.storageService.get(THREADS_STORAGE_KEY, StorageScope.WORKSPACE);
+		if (!raw) {
+			return [];
+		}
+		try {
+			return JSON.parse(raw) as IChatThread[];
+		} catch {
+			return [];
+		}
+	}
+
+	private persistThreads(): void {
+		this.storageService.store(THREADS_STORAGE_KEY, JSON.stringify(this.threads), StorageScope.WORKSPACE, StorageTarget.MACHINE);
+	}
+}
+
+registerSingleton(IVSCodeEgyptChatService, VSCodeEgyptChatService, InstantiationType.Delayed);
