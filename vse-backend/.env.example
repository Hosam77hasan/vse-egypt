# Copy to .env and fill in real values. Never commit the real .env file.

PORT=8787
NODE_ENV=production

# DeepSeek — the only place this key exists. The IDE client never sees it.
DEEPSEEK_API_KEY=sk-REPLACE_ME
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Signing secret for issued license JWTs — must match what the payment portal
# uses to sign license tokens after a successful checkout.
LICENSE_JWT_SECRET=REPLACE_ME_LONG_RANDOM_SECRET

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Per-plan monthly token allowances (soft cap enforced in tokenGuard middleware)
PLAN_FREE_MONTHLY_TOKENS=0
PLAN_PRO_MONTHLY_TOKENS=2000000
PLAN_TEAM_MONTHLY_TOKENS=8000000

# Shared secret between vse-payment-portal's server and this backend for the
# internal-only /v1/license/issue call. Must never be reachable from the public internet.
PAYMENT_PORTAL_INTERNAL_SECRET=REPLACE_ME_ANOTHER_LONG_RANDOM_SECRET

SQLITE_DB_PATH=./db/vse.sqlite

# On Railway: mount a Volume (e.g. at /data) and set this to a path inside it, so
# the database survives redeploys instead of living on the container's ephemeral
# filesystem. Takes priority over SQLITE_DB_PATH above if both are set.
#   DATABASE_PATH=/data/vse.sqlite
DATABASE_PATH=

# Comma-separated list of extra allowed CORS origins, for the landing page
# (GitHub Pages) and payment portal in production. localhost origins for local
# dev are already allowed by default, no need to list them here.
#   CORS_ORIGIN=https://yourname.github.io,https://vse-payment-portal.up.railway.app
CORS_ORIGIN=

# Email (OTP / verification). If SMTP_HOST is unset, the server runs in
# dev mode and logs emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VS Code Egypt <no-reply@vscode-egypt.example>

# ---------------------------------------------------------------------------
# Manual payment queue + hidden admin PWA (services/payment/, routes/payment.js)
# ---------------------------------------------------------------------------

# 'manual' (default) = payment_requests queue reviewed by a human admin.
# 'automated' = services/payment/AutomatedPaymentProvider.js, not implemented yet.
PAYMENT_MODE=manual

# Signs the admin PWA's session token, issued after passcode login. Completely
# separate secret from LICENSE_JWT_SECRET — the admin session and customer
# login are two unrelated auth systems on purpose (a leaked customer JWT
# should never be usable against the admin panel, and vice versa).
ADMIN_JWT_SECRET=REPLACE_ME_YET_ANOTHER_LONG_RANDOM_SECRET

# bcrypt hash of the admin passcode — NEVER the raw passcode. Generate your own
# with `node scripts/hash-admin-passcode.js`.
#
# The line below hashes "3317167" (the code from the original spec for this
# feature) purely so the server boots with SOMETHING out of the box. Because
# that passcode was typed into a chat transcript to write this spec, treat it
# as already compromised — run the script above and replace this line with a
# hash of a passcode only you know before this ever goes near production.
ADMIN_PASSCODE_HASH=$2a$12$UKpv0aHjFi/t9GgiuzG/oOra1xw9hcSIUb25ANz8fhfWfPWLiw86O

# Failed-login lockout (middleware/adminAuth.js) — persisted in SQLite, survives
# a restart, on top of the in-memory rate limit already applied to the route.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_MINUTES=30

# Manual top-up conversion rate: tokens granted per unit of currency submitted.
# (The automated ladder in routes/topup.js uses fixed EGP tiers instead; this is
# a rate because a manual submission can be any amount.)
TOKENS_PER_EGP=2000
TOKENS_PER_USD=100000

# Web Push (services/push.js) for the hidden admin PWA. Optional — the admin
# panel works without these, just without instant push notifications. Generate
# with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
